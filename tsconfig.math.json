{
  // Purity boundary for src/math: no DOM lib and no ambient types (not even Node).
  // Any use of window, document, process, etc. inside the math engine fails to compile.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.math.tsbuildinfo"
  },
  "include": ["src/math"],
  "exclude": ["src/math/**/*.test.ts"]
}
