{
  "name": "deep-reef",
  "version": "0.1.0",
  "private": true,
  "description": "A 5x3, 20-line video slot with wild, scatter and free spins. It is a portfolio project built with TypeScript, PixiJS v8, React, Redux Toolkit and GSAP.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gazeto100/deep-reef.git"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @deep-reef/web --",
    "build": "tsc -b && npm run build -w @deep-reef/web",
    "preview": "npm run preview -w @deep-reef/web --",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "math:tune": "npm run tune -w @deep-reef/math --",
    "math:exact": "npm run exact -w @deep-reef/math --",
    "math:sim": "npm run sim -w @deep-reef/math --",
    "math:verify": "npm run verify -w @deep-reef/math --",
    "api:openapi": "npm run openapi -w @deep-reef/contract",
    "api:lint": "npm run openapi:lint -w @deep-reef/contract"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
