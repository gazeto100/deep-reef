# Copy to .env.local and adjust. All variables are optional.

# Which GameServer the client uses: "mock" (in-browser game core, default) or "http".
VITE_GAME_SERVER=mock

# Base URL of the game server when VITE_GAME_SERVER=http (phase 3b).
# VITE_API_URL=http://localhost:3000

# Mock only: "none" (default) or "flaky" to inject network errors, server errors and
# lost responses, which shows timeouts and idempotent retries in action.
VITE_MOCK_FAULTS=none

# Per-request timeout in milliseconds before the client retries (default 3000).
VITE_SERVER_TIMEOUT_MS=3000
