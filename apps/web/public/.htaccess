# Deep Reef static demo on Apache (cPanel). Copied into dist/ by the build.

Options -Indexes

# HTTP -> HTTPS. Needs a valid certificate (cPanel > SSL/TLS Status > AutoSSL); on a host
# without one, comment this block out. /.well-known/ is left alone so that certificate
# validation and renewal keep working.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Files in assets/ have a content hash in their name and never change: cache for a year.
  <FilesMatch "\.(js|css|svg|png|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html must be revalidated, so a new deploy is picked up at once.
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
